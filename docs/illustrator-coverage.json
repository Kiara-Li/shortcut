  "contextExclusions": [
    {
      "id": "prototype-player",
      "keys": [
        "F",
        "Z",
        "R",
        "C",
        "LEFT",
        "RIGHT",
        "SPACE",
        "N"
      ],
      "reason": "Prototype playback has its own context. The Illustrator canvas must not interpret R as restart or F as fullscreen.",
      "source": "https://help.figma.com/hc/en-us/articles/360040318013-Play-your-prototypes"
    },
    {
      "id": "text-and-ime",
      "keys": [
        "typing",
        "selection/caret movement",
        "Cmd+Return",
        "Escape"
      ],
      "reason": "All protected text fields, canvas text editing and Secure Input preserve native input. Text-object alignment/size applies only outside protected entry.",
      "source": "https://developer.apple.com/documentation/applicationservices/axuielement"
    },
    {
      "id": "auto-layout-alignment-box",
      "keys": [
        "W",
        "A",
        "S",
        "D",
        "arrows",
        "B",
        "X"
      ],
      "reason": "Keys active inside Figma’s focused layout control are not canvas-global commands. Illustrator has no equivalent focused control.",
      "source": "https://help.figma.com/hc/en-us/articles/360040451373-Guide-to-auto-layout-in-Figma"
    },
    {
      "id": "other-products",
      "keys": [
        "FigJam",
        "Slides",
        "Sites",
        "Make",
        "Buzz",
        "Dev Mode",
        "Motion"
      ],
      "reason": "Separate product/tool contexts need their own catalogs. Figma Design assets, components, vector editing and accessibility are classified here.",
      "source": "https://help.figma.com/hc/en-us/articles/360040328653-Use-Figma-products-with-a-keyboard"
    },
    {
      "id": "custom-keymaps",
      "keys": [
        "non-US physical layouts",
        "custom Illustrator shortcuts",
        "legacy Figma outlines preference"
      ],
      "reason": "No guessing a customized user keymap; this catalog assumes documented defaults.",
      "source": "https://help.figma.com/hc/en-us/articles/5665442977431-Select-keyboard-layout"
    }
  ],
  "legacyConflicts": [
